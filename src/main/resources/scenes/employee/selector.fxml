<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="583.0" prefWidth="1004.0" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.anescdev.velox.context.employee.view.controller.EmployeeSelectorController">
   <center>
      <GridPane hgap="5.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="0.0" minWidth="0.0" prefHeight="359.0" prefWidth="475.0" vgap="5.0" BorderPane.alignment="CENTER">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="898.0" minWidth="10.0" prefWidth="491.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="910.0" minWidth="10.0" prefWidth="513.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="910.0" minWidth="10.0" prefWidth="513.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="910.0" minWidth="10.0" prefWidth="513.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints maxHeight="89.0" minHeight="10.0" prefHeight="64.0" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="72.0" minHeight="0.0" prefHeight="45.0" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="70.0" minHeight="8.0" prefHeight="16.0" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="116.0" minHeight="10.0" prefHeight="96.0" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="70.0" minHeight="6.0" prefHeight="21.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <HBox spacing="5.0" GridPane.columnSpan="4" GridPane.hgrow="NEVER" GridPane.rowIndex="3" GridPane.valignment="TOP">
