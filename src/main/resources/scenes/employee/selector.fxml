            <ComboBox fx:id="employeeCombo" maxWidth="1.7976931348623157E308" prefHeight="28.0" prefWidth="0.0" promptText="%employee.dropdown.default" HBox.hgrow="ALWAYS" />
            <Button contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#createEmployee" text="Button">
              <graphic>
                <FontIcon iconLiteral="unil-plus" iconSize="16" strokeWidth="0.0" />
              </graphic>
            </Button>
               </children>
            </HBox>
      <Button fx:id="deleteButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#deleteEmployee" prefHeight="28.0" text="%employee.deleteButton.text" GridPane.columnSpan="2" GridPane.halignment="LEFT" GridPane.rowIndex="4" />
      <Button fx:id="selectButton" defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#selectEmployee" prefHeight="28.0" text="%employee.selectButton.text" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.halignment="RIGHT" GridPane.rowIndex="4" />
