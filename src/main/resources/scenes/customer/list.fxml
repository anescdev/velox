<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox spacing="12.0" styleClass="tab-content-separation" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.anescdev.velox.context.customer.view.controller.CustomerListController">
  <children>
    <TableView fx:id="customerTable" HBox.hgrow="ALWAYS">
      <columns>
        <TableColumn fx:id="nameColumn" prefWidth="75.0" text="%customer.table.column.name" />
        <TableColumn fx:id="abreviationColumn" prefWidth="75.0" text="%customer.table.column.abbreviation" />
      </columns>
      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
      <contextMenu>
        <ContextMenu>
          <items>
            <MenuItem mnemonicParsing="false" onAction="#createButton" text="%customer.list.action.add">
              <graphic>
                <FontIcon iconLiteral="unil-user-plus" />
              </graphic>
            </MenuItem>
            <SeparatorMenuItem />
            <MenuItem fx:id="detailsMenuItem" disable="true" mnemonicParsing="false" onAction="#detailsButton" text="%customer.list.action.details">
              <graphic>
                <FontIcon iconLiteral="unil-user-square" />
              </graphic>
            </MenuItem>
            <MenuItem fx:id="removeSelectedMenuItem" disable="true" mnemonicParsing="false" onAction="#deleteSelected" text="%customer.list.action.remove">
              <graphic>
                <FontIcon iconLiteral="unil-trash-alt" />
              </graphic>
            </MenuItem>
          </items>
        </ContextMenu>
      </contextMenu>
    </TableView>
    <VBox alignment="TOP_CENTER" spacing="12.0" HBox.hgrow="NEVER">
      <children>
        <Button mnemonicParsing="false" onAction="#createButton">
          <graphic>
            <FontIcon iconLiteral="unil-user-plus" iconSize="24" />
          </graphic>
        </Button>
        <Separator orientation="HORIZONTAL" />
        <Button fx:id="detailsBtn" disable="true" mnemonicParsing="false" onAction="#detailsButton">
          <graphic>
            <FontIcon iconLiteral="unil-user-square" iconSize="24" />
          </graphic>
        </Button>
        <Button fx:id="removeSelectedBtn" disable="true" mnemonicParsing="false" onAction="#deleteSelected">
          <graphic>
            <FontIcon iconLiteral="unil-trash-alt" iconSize="24" />
          </graphic>
        </Button>
      </children>
    </VBox>
  </children>
</HBox>
