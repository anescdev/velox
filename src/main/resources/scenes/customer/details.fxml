<?xml version="1.0" encoding="UTF-8"?>

<?import es.anescdev.velox.core.view.components.TitledPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.anescdev.velox.context.customer.view.controller.CustomerDetailsController">
  <center>
      <VBox spacing="20.0" styleClass="tab-content-separation" BorderPane.alignment="TOP_CENTER">
         <children>
          <TitledPane animated="false" text="%customer.details.section.data">
            <content>
              <HBox fillHeight="false" prefWidth="200.0" spacing="20.0">
                <children>
                        <VBox>
                           <children>
                      <Label styleClass="label-tag" text="%customer.details.label.name" />
                              <Label fx:id="customerName" styleClass="label-value" text="loplo" />
                           </children>
                        </VBox>
                        <VBox>
                           <children>
                      <Label styleClass="label-tag" text="%customer.details.label.abbreviation" />
                              <Label fx:id="customerAbbreviation" styleClass="cod-badge" text="Label" />
                           </children>
                        </VBox>
                </children>
              </HBox>
            </content>
          </TitledPane>
          <TitledPane animated="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%customer.details.section.cod" VBox.vgrow="NEVER">
            <content>
                  <VBox>
                     <children>
                        <HBox prefWidth="200.0" spacing="15.0">
                           <children>
                              <Button fx:id="addCod" mnemonicParsing="false" onAction="#addCod" text="%cod.table.add" />
                              <Button fx:id="removeCod" mnemonicParsing="false" onAction="#deleteCod" text="%cod.table.delete" />
                           </children>
                           <VBox.margin>
                              <Insets bottom="10.0" />
                           </VBox.margin>
                        </HBox>
                    <TableView fx:id="codTable" editable="true" VBox.vgrow="ALWAYS">
                      <columns>
                        <TableColumn fx:id="codColumn" prefWidth="75.0" text="%cod.table.column.cod" />
                        <TableColumn fx:id="descriptionColumn" prefWidth="75.0" text="%cod.table.column.description" />
                        <TableColumn fx:id="timeWorkedColumn" prefWidth="75.0" text="%cod.table.column.timeWorked" />
                      </columns>
                      <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                      </columnResizePolicy>
                    </TableView>
                     </children>
                  </VBox>
            </content>
          </TitledPane>
         </children>
      </VBox>
  </center>
   <top>
      <HBox prefWidth="200.0" spacing="15.0" styleClass="tab-content-separation" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="saveCustomer" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#saveCustomer" text="%customer.details.save" />
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </HBox>
   </top>
</BorderPane>
