<?xml version="1.0" encoding="UTF-8"?>

<?import es.anescdev.velox.core.view.components.TitledPane?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="12.0" styleClass="tab-content-separation" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.anescdev.velox.context.customer.view.controller.CustomerDetailsController">
  <children>
    <TitledPane animated="false" text="%customer.details.section.data">
      <content>
        <HBox fillHeight="false" prefWidth="200.0" spacing="20.0">
          <children>
            <VBox>
              <children>
                <Label styleClass="label-tag" text="%customer.details.label.name" />
                <Label fx:id="customerName" styleClass="label-value" text="loplo" />
              </children>
            </VBox>
            <VBox>
              <children>
                <Label styleClass="label-tag" text="%customer.details.label.abbreviation" />
                <Label fx:id="customerAbbreviation" styleClass="cod-badge" text="Label" />
              </children>
            </VBox>
          </children>
        </HBox>
      </content>
    </TitledPane>
    <TitledPane fx:id="codPane" animated="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" text="%customer.details.section.cod" VBox.vgrow="ALWAYS">
      <content>
        <HBox spacing="10.0">
          <children>
            <TableView fx:id="codTable" editable="true" minHeight="90.0" HBox.hgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="codColumn" prefWidth="75.0" text="%cod.table.column.cod" />
                <TableColumn fx:id="descriptionColumn" prefWidth="75.0" text="%cod.table.column.description" />
                <TableColumn fx:id="timeWorkedColumn" prefWidth="75.0" text="%cod.table.column.timeWorked" />
              </columns>
              <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
              </columnResizePolicy>
              <contextMenu>
                <ContextMenu>
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#addCod" text="%cod.list.action.add">
                      <graphic>
                        <FontIcon iconLiteral="unil-plus" />
                      </graphic>
                    </MenuItem>
                    <MenuItem fx:id="deleteCodMenuItem" mnemonicParsing="false" onAction="#deleteCod" text="%cod.list.action.delete">
                      <graphic>
                        <FontIcon iconLiteral="unil-trash" />
                      </graphic>
                    </MenuItem>
                    <SeparatorMenuItem />
                    <MenuItem fx:id="saveCodsMenuItem" mnemonicParsing="false" onAction="#saveCustomer" text="%cod.list.action.save">
                      <graphic>
                        <FontIcon iconLiteral="unil-save" />
                      </graphic>
                    </MenuItem>
                  </items>
                </ContextMenu>
              </contextMenu>
            </TableView>
            <VBox prefWidth="0.0" spacing="10.0">
              <children>
                <Button fx:id="saveCustomer" mnemonicParsing="false" onAction="#saveCustomer">
                  <graphic>
                    <FontIcon iconLiteral="unil-save" iconSize="24" />
                  </graphic>
                </Button>
                        <Separator prefWidth="200.0" />
                <Button fx:id="addCod" mnemonicParsing="false" onAction="#addCod">
                  <styleClass>
                    <String fx:value="button" />
                    <String fx:value="compact" />
                  </styleClass>
                  <graphic>
                    <FontIcon iconLiteral="unil-plus" iconSize="24" />
                  </graphic>
                </Button>
                <Button fx:id="removeCod" mnemonicParsing="false" onAction="#deleteCod" styleClass="compact">
                  <graphic>
                    <FontIcon iconLiteral="unil-trash-alt" iconSize="24" />
                  </graphic>
                </Button>
              </children>
            </VBox>
          </children>
        </HBox>
      </content>
    </TitledPane>
  </children>
</VBox>
