<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.anescdev.workspace.view.controller.WorkspaceController">
  <children>
    <MenuBar>
      <menus>
        <Menu mnemonicParsing="false" text="%main.menubar.app">
          <items>
            <MenuItem disable="true" mnemonicParsing="false" text="%main.menubar.app.securityCopy.create" />
            <MenuItem disable="true" mnemonicParsing="false" text="%main.menubar.app.securityCopy.load" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" onAction="#exitApp" text="%main.menubar.app.exit">
              <graphic>
                <FontIcon iconLiteral="typ-times" iconSize="16" />
              </graphic>
            </MenuItem>
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="%main.menubar.sheets">
          <items>
            <MenuItem mnemonicParsing="false" onAction="#openEmployeesList" text="%main.menubar.sheets.employee.list">
              <graphic>
                <FontIcon iconLiteral="typ-user" iconSize="16" />
              </graphic>
            </MenuItem>
            <MenuItem mnemonicParsing="false" text="%main.menubar.sheets.employee.add">
              <graphic>
                <FontIcon iconLiteral="typ-user-add" iconSize="16" />
              </graphic>
            </MenuItem>
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="%main.menubar.sheets.customer.list">
              <graphic>
                <FontIcon iconLiteral="typ-user" iconSize="16" />
              </graphic>
            </MenuItem>
            <MenuItem mnemonicParsing="false" text="%main.menubar.sheets.customer.add">
              <graphic>
                <FontIcon iconLiteral="typ-user-add" iconSize="16" />
              </graphic>
            </MenuItem>
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="%main.menubar.sumatory">
          <items>
            <MenuItem mnemonicParsing="false" onAction="#openSumatoryList" text="%main.menubar.sumatory.list">
              <graphic>
                <FontIcon iconLiteral="typ-document" iconSize="16" />
              </graphic>
            </MenuItem>
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="%main.menubar.sumatory.add">
              <graphic>
                <FontIcon iconLiteral="typ-document-add" iconSize="16" />
              </graphic>
            </MenuItem>
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="%main.menubar.help">
          <items>
            <MenuItem mnemonicParsing="false" onAction="#showAppInfo" text="%main.menubar.help.info">
              <graphic>
                <FontIcon iconLiteral="typ-info" iconSize="16" />
              </graphic>
            </MenuItem>
          </items>
        </Menu>
      </menus>
    </MenuBar>
    <TabPane fx:id="workspace" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" tabClosingPolicy="ALL_TABS" VBox.vgrow="ALWAYS" />
  </children>
</VBox>
