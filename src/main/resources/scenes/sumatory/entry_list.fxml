<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="tab-content-separation" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.anescdev.velox.context.sumatory.view.controller.SumatoryDetailsController">
  <children>
    <HBox spacing="12" VBox.vgrow="ALWAYS">
      <children>
        <TableView fx:id="sumatoryEntryTable" editable="true" HBox.hgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="codColumn" prefWidth="100.0" text="%sumatoryentry.table.column.cod" />
            <TableColumn fx:id="dayColumn" prefWidth="200.0" text="%sumatoryentry.table.column.day" />
            <TableColumn fx:id="descriptionColumn" prefWidth="300.0" text="%sumatoryentry.table.column.description" />
            <TableColumn fx:id="totalColumn" prefWidth="120.0" text="%sumatoryentry.table.column.total" />
            <TableColumn fx:id="timeWorkedPerDayColumn" prefWidth="120.0" text="%sumatoryentry.table.column.perDay" />
          </columns>
          <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem fx:id="saveSumatoryMenuItem" disable="true" mnemonicParsing="false" onAction="#saveSumatory" text="%sumatoryentry.list.action.save">
                  <graphic>
                    <FontIcon iconLiteral="unil-save" iconSize="24" />
                  </graphic>
                </MenuItem>
                <SeparatorMenuItem />
                <MenuItem fx:id="addSumatoryEntryMenuItem" mnemonicParsing="false" onAction="#createSumatoryEntry" text="%sumatoryentry.list.action.add">
                  <graphic>
                    <FontIcon iconLiteral="unil-plus" iconSize="24" />
                  </graphic>
                </MenuItem>
                <MenuItem fx:id="removeSumatoryEntryMenuItem" disable="true" mnemonicParsing="false" onAction="#deleteSelected" text="%sumatoryentry.list.action.remove">
                  <graphic>
                    <FontIcon iconLiteral="unil-trash-alt" iconSize="24" />
                  </graphic>
                </MenuItem>
                <SeparatorMenuItem />
                <MenuItem mnemonicParsing="false" fx:id="exportSumatoryMenuItem" onAction="#printSumatory" text="%sumatoryentry.list.action.export">
                  <graphic>
                    <FontIcon iconLiteral="unil-file-export" iconSize="24" />
                  </graphic>
                </MenuItem>
              </items>
            </ContextMenu>
          </contextMenu>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
        </TableView>
        <VBox prefWidth="0.0" spacing="12">
          <children>
            <Button fx:id="saveSumatoryBtn" disable="true" mnemonicParsing="false" onAction="#saveSumatory">
              <graphic>
                <FontIcon iconLiteral="unil-save" iconSize="24" />
              </graphic>
            </Button>
            <Separator orientation="HORIZONTAL" />
            <Button fx:id="addSumatoryEntryBtn" mnemonicParsing="false" onAction="#createSumatoryEntry">
              <graphic>
                <FontIcon iconLiteral="unil-plus" iconSize="24" />
              </graphic>
            </Button>
            <Button fx:id="removeSumatoryEntryBtn" disable="true" mnemonicParsing="false" onAction="#deleteSelected">
              <graphic>
                <FontIcon iconLiteral="unil-trash-alt" iconSize="24" />
              </graphic>
            </Button>
            <Separator orientation="HORIZONTAL" />
            <Button fx:id="exportSumatoryButton" mnemonicParsing="false" onAction="#printSumatory">
              <graphic>
                <FontIcon iconLiteral="unil-file-export" iconSize="24" />
              </graphic>
            </Button>
          </children>
        </VBox>
      </children>
    </HBox>
    <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0">
      <children>
        <Label alignment="BASELINE_CENTER" styleClass="label-tag" text="%sumatoryentry.label.monthtotal" />
        <Label fx:id="monthTotalLabel" alignment="BASELINE_CENTER" styleClass="total-label" text="time" />
      </children>
    </HBox>
  </children>
</VBox>
