<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.anescdev.velox.context.sumatory.view.controller.SumatoryDetailsController">
  <top>
    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="tab-content-separation" BorderPane.alignment="CENTER">
      <children>
        <Button fx:id="saveSumatoryBtn" disable="true" mnemonicParsing="false" onAction="#saveSumatory" text="%sumatoryentry.list.action.save"/>
        <Button fx:id="addSumatoryEntryBtn" mnemonicParsing="false" onAction="#createSumatoryEntry" text="%sumatoryentry.list.action.add"/>
        <Button fx:id="removeSumatoryEntryBtn" disable="true" mnemonicParsing="false" onAction="#deleteSelected" text="%sumatoryentry.list.action.remove"/>
        <Button mnemonicParsing="false" onAction="#printSumatory" text="%sumatoryentry.list.action.export"/>
      </children>
      <BorderPane.margin>
        <Insets bottom="14.0"/>
      </BorderPane.margin>
    </HBox>
  </top>

  <center>
    <VBox styleClass="tab-content-separation">
      <children>
        <TableView fx:id="sumatoryEntryTable" editable="true" VBox.vgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="codColumn" prefWidth="75.0" text="%sumatoryentry.table.column.cod"/>
            <TableColumn fx:id="dayColumn" prefWidth="75.0" text="%sumatoryentry.table.column.day"/>
            <TableColumn fx:id="descriptionColumn" prefWidth="75.0" text="%sumatoryentry.table.column.description"/>
            <TableColumn fx:id="totalColumn" minWidth="0.0" prefWidth="132.0" text="%sumatoryentry.table.column.total"/>
          </columns>
          <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
          </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0">
          <children>
            <Label alignment="BASELINE_CENTER" styleClass="label-tag" text="%sumatoryentry.label.monthtotal"/>
            <Label fx:id="monthTotalLabel" alignment="BASELINE_CENTER" styleClass="total-label" text="time"/>
          </children>
        </HBox>
      </children>
    </VBox>
  </center>
</BorderPane>
