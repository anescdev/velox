<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" spacing="12.0" styleClass="tab-content-separation" fx:controller="es.anescdev.velox.context.sumatory.view.controller.SumatoryListController">
  <children>
    <TableView fx:id="sumatoryTable" HBox.hgrow="ALWAYS">
      <columns>
        <TableColumn fx:id="monthColumn" prefWidth="75.0" text="%sumatory.table.column.month"/>
        <TableColumn fx:id="yearColumn" prefWidth="75.0" text="%sumatory.table.column.year"/>
        <TableColumn fx:id="totalColumn" minWidth="0.0" prefWidth="132.0" text="%sumatory.table.column.total"/>
      </columns>
      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
      </columnResizePolicy>
      <contextMenu>
        <ContextMenu>
          <items>
            <MenuItem mnemonicParsing="false" onAction="#createSumatory" text="%sumatory.list.action.add">
              <graphic>
                <FontIcon iconLiteral="unil-file-plus-alt"/>
              </graphic>
            </MenuItem>
            <SeparatorMenuItem/>
            <MenuItem fx:id="detailsMenuItem" disable="true" mnemonicParsing="false" onAction="#detailsButtonSumatory" text="%sumatory.list.action.details">
              <graphic>
                <FontIcon iconLiteral="unil-file-alt"/>
              </graphic>
            </MenuItem>
            <MenuItem fx:id="removeMenuItem" disable="true" mnemonicParsing="false" onAction="#deleteSelected" text="%sumatory.list.action.remove">
              <graphic>
                <FontIcon iconLiteral="unil-trash-alt"/>
              </graphic>
            </MenuItem>
          </items>
        </ContextMenu>
      </contextMenu>
    </TableView>
    <VBox alignment="TOP_CENTER" spacing="12.0" BorderPane.alignment="CENTER">
      <children>
        <Button mnemonicParsing="false" onAction="#createSumatory">
          <graphic>
            <FontIcon iconLiteral="unil-file-plus-alt" iconSize="24"/>
          </graphic>
        </Button>
        <Separator orientation="HORIZONTAL"/>
        <Button fx:id="detailsBtn" disable="true" mnemonicParsing="false" onAction="#detailsButtonSumatory">
          <graphic>
            <FontIcon iconLiteral="unil-file-alt" iconSize="24"/>
          </graphic>
        </Button>
        <Button fx:id="removeBtn" disable="true" mnemonicParsing="false" onAction="#deleteSelected">
          <graphic>
            <FontIcon iconLiteral="unil-trash-alt" iconSize="24"/>
          </graphic>
        </Button>
      </children>
    </VBox>
  </children>
</HBox>
