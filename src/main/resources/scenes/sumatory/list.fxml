<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.anescdev.velox.context.sumatory.view.controller.SumatoryListController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="tab-content-separation" BorderPane.alignment="CENTER">
         <children>
        <Button fx:id="detailsBtn" disable="true" mnemonicParsing="false" onAction="#detailsButtonSumatory" text="%sumatory.list.action.details" />
        <Button mnemonicParsing="false" onAction="#createSumatory" text="%sumatory.list.action.add" />
        <Button fx:id="removeBtn" disable="true" mnemonicParsing="false" onAction="#deleteSelected" text="%sumatory.list.action.remove" />
         </children>
         <BorderPane.margin>
            <Insets bottom="14.0" />
         </BorderPane.margin>
      </HBox>
   </top>
   <center>
      <StackPane styleClass="tab-content-separation" BorderPane.alignment="CENTER">
         <children>
          <TableView fx:id="sumatoryTable">
            <columns>
              <TableColumn fx:id="monthColumn" prefWidth="75.0" text="%sumatory.table.column.month" />
              <TableColumn fx:id="yearColumn" prefWidth="75.0" text="%sumatory.table.column.year" />
              <TableColumn fx:id="totalColumn" minWidth="0.0" prefWidth="132.0" text="%sumatory.table.column.total" />
            </columns>
            <columnResizePolicy>
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
          </TableView>
         </children>
      </StackPane>
   </center>
</BorderPane>
