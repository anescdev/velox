<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.anescdev.sumatory.view.controller.SumatoryListController">
  <center>
    <TableView fx:id="sumatoryTable" BorderPane.alignment="CENTER">
      <columns>
        <TableColumn fx:id="monthColumn" prefWidth="75.0" text="%sumatory.list.column.month"/>
        <TableColumn fx:id="yearColumn" prefWidth="75.0" text="%sumatory.list.column.year"/>
        <TableColumn fx:id="employeeColumn" prefWidth="91.0" text="%sumatory.list.column.employee"/>
        <TableColumn fx:id="totalColumn" minWidth="0.0" prefWidth="132.0" text="%sumatory.list.column.total"/>
      </columns>
      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
      </columnResizePolicy>
    </TableView>
  </center>

  <left>
    <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0" BorderPane.alignment="CENTER_LEFT">
      <children>
        <Button fx:id="detailsBtn" mnemonicParsing="false" disable="true" text="%sumatory.list.action.details"/>
        <Button mnemonicParsing="false" onAction="#createSumatory" text="%sumatory.list.action.add"/>
        <Button fx:id="removeBtn" mnemonicParsing="false" onAction="#deleteSelected" disable="true" text="%sumatory.list.action.remove"/>
      </children>
      <opaqueInsets>
        <Insets/>
      </opaqueInsets>
      <BorderPane.margin>
        <Insets top="5.0"/>
      </BorderPane.margin>
    </VBox>
  </left>
</BorderPane>
