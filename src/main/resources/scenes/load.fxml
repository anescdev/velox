<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" style="-fx-background-color: -fx-color-bg-canvas;" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.anescdev.velox.app.loader.controller.LoadController">
   <children>
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../img/imagotipo.png" />
         </image>
         <VBox.margin>
            <Insets top="25.0" />
         </VBox.margin>
      </ImageView>
      <Label fx:id="loadingMessageText" />
      <ProgressBar fx:id="loadingProgress" prefHeight="20.0" prefWidth="319.0" />
      <Label fx:id="loadingCountText" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
