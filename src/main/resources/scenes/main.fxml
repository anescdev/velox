<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.anescdev.view.controller.MainController">
  <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="%main.menubar.app">
          <items>
            <MenuItem mnemonicParsing="false" text="%main.menubar.app.securityCopy.create" disable="true" />
            <MenuItem mnemonicParsing="false" text="%main.menubar.app.securityCopy.load" disable="true" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="%main.menubar.app.exit" onAction="#exitApp"/>
          </items>
          </Menu>
          <Menu mnemonicParsing="false" text="%main.menubar.employee">
            <items>
              <MenuItem mnemonicParsing="false" text="%main.menubar.employee.list" onAction="#openEmployeesList"/>
              <SeparatorMenuItem mnemonicParsing="false" />
              <MenuItem mnemonicParsing="false" text="%main.menubar.employee.add" />
              <MenuItem mnemonicParsing="false" text="%main.menubar.employee.remove" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="%main.menubar.sumatory">
            <items>
              <MenuItem mnemonicParsing="false" text="%main.menubar.sumatory.list" onAction="#openSumatoryList" />
              <SeparatorMenuItem mnemonicParsing="false" />
              <MenuItem mnemonicParsing="false" text="%main.menubar.sumatory.add" />
              <MenuItem mnemonicParsing="false" text="%main.menubar.sumatory.remove" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="%main.menubar.help">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#showAppInfo" text="%main.menubar.help.info">
              <graphic>
                <FontIcon iconLiteral="typ-info" iconSize="16"/>
              </graphic>
              </MenuItem>
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <TabPane prefHeight="219.0" prefWidth="231.0" tabClosingPolicy="ALL_TABS" fx:id="workspace" />
  </children>
</VBox>
